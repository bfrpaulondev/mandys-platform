{
  "name": "@mandys/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --platform node --target node24 --clean --out-dir dist",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@mandys/tsconfig": "workspace:*",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0"
  }
}
