# Runtime
NODE_ENV=development

# URLs
STOREFRONT_URL=http://localhost:3000
BACKOFFICE_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL / Supabase server connection
# Required by the Fastify API + Better Auth. Keep these server-side only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:4000

# Supabase browser-safe configuration
# Publishable values may be exposed to the browser. Mandy's business tables are
# still backend-only and are not accessible through the public Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side Supabase services (Storage/administration only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Future integrations - never expose server secrets as NEXT_PUBLIC_ variables
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
RESEND_API_KEY=
